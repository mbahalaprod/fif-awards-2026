# =============================================================================
# FIF AWARDS 2026 — variables d'environnement
# Copier ce fichier en .env.local (développement) et renseigner les mêmes
# variables dans Vercel (Settings → Environment Variables) pour la production.
# Ne jamais committer de vraies valeurs.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Adresse publique du site (sitemap, partage sur les réseaux, liens des e-mails)
NEXT_PUBLIC_SITE_URL=https://fifawards.gn

# --- Supabase (Project Settings → API) ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » : serveur uniquement, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Secret pour l'empreinte des e-mails et des IP (anti-abus, vote).
# Générer une longue valeur aléatoire, par exemple : openssl rand -hex 32
HASH_SECRET=

# --- E-mails (Resend) ---------------------------------------------------------
# Sans clé, rien n'est envoyé : les formulaires restent enregistrés dans l'admin.
RESEND_API_KEY=
# Expéditeur. Avant la vérification du domaine : FIF AWARDS <onboarding@resend.dev>
EMAIL_EXPEDITEUR=FIF AWARDS <onboarding@resend.dev>
# Destinataires des notifications (candidatures, messages, réservations), séparés par des virgules
EMAIL_EQUIPE=
# Mettre à true seulement quand le domaine est vérifié chez Resend
# (confirmations envoyées aux candidats et aux personnes qui réservent).
EMAIL_CONFIRMATIONS_ACTIVES=false

# --- Vote du public (désactivé en 2026, interrupteur dans /admin/reglages) -----
# Afficher le nombre de votes à côté de chaque choix pendant le vote
NEXT_PUBLIC_SHOW_VOTE_RESULTS=false
